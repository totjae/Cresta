CRESTA_ENVIRONMENT=MOCK
# Set to the exact reviewed candidate commit before evidence publication/deployment.
# CRESTA_DEPLOYED_REVISION=<40 lowercase Git commit SHA>
CRESTA_ARTIFACT_ROOT=/var/lib/cresta-artifacts
CRESTA_LIVE_TRADING_ENABLED=false
CRESTA_EXECUTION_STAGE=SHADOW
CRESTA_DATABASE_URL=postgresql+psycopg://cresta@postgres:5432/cresta
CRESTA_DATABASE_PASSWORD_FILE=/run/secrets/postgres_password
CRESTA_REDIS_URL=redis://redis:6379/0
CRESTA_COOKIE_SECURE=true
CRESTA_ALLOWED_ORIGINS=https://trade.mihoservice.xyz
CRESTA_SESSION_COOKIE_NAME=cresta_session
CRESTA_SESSION_IDLE_MINUTES=30
CRESTA_SESSION_ABSOLUTE_HOURS=8
CRESTA_CHALLENGE_MINUTES=5
CRESTA_REAUTH_MINUTES=5
CRESTA_AUTH_MAX_FAILURES=5
CRESTA_AUTH_LOCK_MINUTES=15
CRESTA_QUOTE_STALE_SECONDS=2
CRESTA_EXPECTED_EGRESS_IP=180.68.4.149
CRESTA_ANALYSIS_SCHEDULER_POLL_SECONDS=5
CRESTA_ANALYSIS_SCHEDULER_LEASE_SECONDS=30
CRESTA_AGENT_WORKER_POLL_SECONDS=1
CRESTA_AGENT_WORKER_LEASE_SECONDS=30
CRESTA_V7_SOURCED_HANDOFF_ENABLED=false
CRESTA_LLM_SECRET_DIRECTORY=/run/cresta-llm-secrets
CRESTA_DART_ENABLED=false
CRESTA_DART_BASE_URL=https://opendart.fss.or.kr
CRESTA_DART_TIMEOUT_SECONDS=5
CRESTA_DART_MAX_PAGES=10
CRESTA_DART_LOOKBACK_DAYS=3
CRESTA_KRX_ENABLED=false
CRESTA_KRX_BASE_URL=https://data-dbg.krx.co.kr
CRESTA_KRX_TIMEOUT_SECONDS=10
CRESTA_KRX_LOOKBACK_DAYS=7
CRESTA_NAVER_NEWS_ENABLED=false
CRESTA_NAVER_NEWS_BASE_URL=https://naverapihub.apigw.ntruss.com
CRESTA_NAVER_NEWS_TIMEOUT_SECONDS=10
CRESTA_NAVER_NEWS_DISPLAY=20
CRESTA_NAVER_NEWS_LOOKBACK_HOURS=72
CRESTA_NAVER_NEWS_CACHE_SECONDS=300
CRESTA_KIWOOM_ENABLED=false
CRESTA_KIWOOM_REST_BASE_URL=https://mockapi.kiwoom.com
CRESTA_KIWOOM_WS_BASE_URL=wss://mockapi.kiwoom.com:10000
CRESTA_KIWOOM_TOKEN_REFRESH_MINUTES=60
CRESTA_KIWOOM_TIMEOUT_SECONDS=5
CRESTA_KIWOOM_WORKER_LEASE_SECONDS=60
CRESTA_KIWOOM_WORKER_HEARTBEAT_SECONDS=10
CRESTA_KIWOOM_RECONCILE_INTERVAL_SECONDS=60
CRESTA_KIWOOM_EVENT_DEBOUNCE_SECONDS=1
CRESTA_KIWOOM_WATCHLIST_SYNC_SECONDS=5
CRESTA_KIWOOM_SOR_ENABLED=false

# 실제 값은 .env가 아니라 Docker secret/read-only file로 주입한다.
CRESTA_TOTP_ENCRYPTION_KEY_FILE=/run/secrets/totp_encryption_key

# 선택 provider/broker를 overlay로 활성화할 때만 아래 file 경로를 해당 Compose가 주입한다.
# CRESTA_DART_API_KEY_FILE=/run/secrets/dart_api_key
# CRESTA_KRX_API_KEY_FILE=/run/secrets/krx_api_key
# CRESTA_NAVER_NEWS_CLIENT_ID_FILE=/run/secrets/naver_api_hub_client_id
# CRESTA_NAVER_NEWS_CLIENT_SECRET_FILE=/run/secrets/naver_api_hub_client_secret
# CRESTA_KIWOOM_APP_KEY_FILE=/run/secrets/kiwoom_mock_app_key
# CRESTA_KIWOOM_APP_SECRET_FILE=/run/secrets/kiwoom_mock_app_secret
# CRESTA_KIWOOM_ACCOUNT_ID_FILE=/run/secrets/kiwoom_mock_account_id
