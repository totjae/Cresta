CRESTA_ENVIRONMENT=MOCK
CRESTA_LIVE_TRADING_ENABLED=false
CRESTA_DATABASE_URL=postgresql+psycopg://cresta@postgres:5432/cresta
CRESTA_DATABASE_PASSWORD_FILE=/run/secrets/postgres_password
